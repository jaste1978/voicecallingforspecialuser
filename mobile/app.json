{
  "expo": {
    "name": "SunoSathi",
    "slug": "sunosathi",
    "version": "1.4.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sunosathi.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "SunoSathi uses the microphone so you can speak to your caller during a captioned call. You can decline and still read captions and type-to-speak.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "./plugins/withRingService"
    ],
    "android": {
      "package": "com.sunosathi.app",
      "versionCode": 5,
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E4590A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}