# Local development settings. Copy to .env — that file is gitignored.
# Railway sets these as real service variables; anything already in the
# environment wins, so this file is only ever read on a laptop.

# The admin account, created on boot. Without it nobody can approve anyone.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-locally
ADMIN_NAME=Admin

# Header key for scripted admin calls (the dataset export). Browser admin
# login works without it.
ADMIN_KEY=local

# 'approval' (default) — new accounts wait for an admin.
# 'open'              — anyone who registers can record straight away.
ACCESS_MODE=approval

# Cloudflare R2. Leave unset and videos are skipped; keypoints still store.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=isl-contributions

# Registration alerts. Unset = logged instead of sent.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
